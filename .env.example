# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Neon PostgreSQL — required for prod, ensures all votes/participants/gifts persist & sync
# If empty, app falls back to in-memory store (dev only, data lost on restart)
DATABASE_URL=postgresql://user:pass@ep-xyz.neon.tech/neondb?sslmode=require&channel_binding=require

# Frontend -> API routing (Vercel split deploy)
# If frontend (phoenix-sws.neka.ng) is on Vercel static and backend is on Render/Railway:
# VITE_API_URL=https://your-api.onrender.com
# VITE_WS_URL=wss://your-api.onrender.com
# If empty, frontend uses same-origin (/api/* and /ws) — works when frontend+backend are one server (local dev, Render single service)
VITE_API_URL=
VITE_WS_URL=
# Optional: disable WS entirely and rely on polling (useful on Vercel serverless where WS 404s)
# VITE_DISABLE_WS=false

# Admin Moderator Credentials — set in Vercel env and locally in .env.local
# Used by AdminAuthGuard (client) — keep secret, never commit real values
VITE_ADMIN_EMAIL=moderator@phoenix.sws
VITE_ADMIN_PASSWORD=admin123
# Alternative server-side names (if you prefer without VITE_ prefix)
# ADMIN_EMAIL=moderator@phoenix.sws
# ADMIN_PASSWORD=admin123

# Vercel / production
APP_URL=https://phoenix-sws.neka.ng
FRONTEND_URL=https://phoenix-sws.neka.ng
